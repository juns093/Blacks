--- !u!114 &1613745092
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1613745088}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ab0324b42ef506745abd2673b8fb6fd0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TypeWriter
  dialogueText: {fileID: 239526142}
  promptText: {fileID: 0}
  dialoguePanel: {fileID: 1613745088}
  hidePanelOnFinish: 1
  dialoguePanelBackground: {fileID: 0}
  hidePanelBackground: 0
  dialogueGroups:
  - groupName: Item1
    lines:
    - "\uB204\uAD6C\uC2DC\uC8E0?"
    - "\uD2B8\uB808\uC77C: \uC804 Drail\uC81C\uC57D\uD68C\uC0AC\uC758 \uC0AC\uC7A5
      \uD2B8\uB808\uC77C \uC785\uB2C8\uB2E4"
    - "\uB192\uC740\uBD84\uAED8\uC11C \uC65C...?"
    - "\uD2B8\uB808\uC77C: \uC7AC\uD310\uACFC \uAD00\uB828\uD574\uC11C \uBD80\uD0C1\uB4DC\uB9B4
      \uC77C\uC774 \uD558\uB098 \uC788\uC2B5\uB2C8\uB2E4."
    - "\uC5B4\uB5A4 \uC0AC\uAC74\uC774\uC8E0?"
    - "\uD2B8\uB808\uC77C: \uC800\uD76C \uD68C\uC0AC\uC5D0\uC11C \uC9C4\uD589\uD55C
      \uC784\uC0C1\uC2E4\uD5D8\uACFC \uAD00\uB828\uB41C \uC0AC\uAC74\uC785\uB2C8\uB2E4."
    - "\uC784\uC0C1\uC2E4\uD5D8\uC774\uB77C..."
    - "\uC774\uBC88 \uC7AC\uD310\uC744... \uC870\uC6A9\uD788 \uB05D\uB0B4\uC8FC\uC168\uC73C\uBA74
      \uD569\uB2C8\uB2E4."
    - "\uB300\uAC00\uAC00 \uC788\uC2B5\uB2C8\uAE4C?"
    - "\uD2B8\uB808\uC77C: \uBB3C\uB860\uC785\uB2C8\uB2E4. \uCDA9\uBD84\uD788 \uC900\uBE44\uD558\uACA0\uC2B5\uB2C8\uB2E4."
    - "\uADF8\uB807\uB2E4\uBA74 \uC774\uC57C\uAE30\uAC00 \uC27D\uACA0\uAD70\uC694."
  - groupName: Item2
    lines:
    - "(\uC784\uC0C1\uC2E4\uD5D8\uC758 \uACB0\uACFC\uBB3C\uC774 \uBB50\uC9C0?)"
    - "\uC800\uAC70 \uBB50\uC57C \uC660 \uC9D0\uC2B9\uC758 \uBC1C\uC774..?"
  - groupName: Item3
    lines:
    - "\uB4DC\uB808\uC77C: \uC624... \uB4DC\uB514\uC5B4 \uC624\uC168\uAD70\uC694."
    - "\uB2F9\uC2E0\uC774 \uB4DC\uB808\uC77C\uC778\uAC00?"
    - "\uB4DC\uB808\uC77C: \uB9DE\uC2B5\uB2C8\uB2E4. \uC774 \uC704\uB300\uD55C \uC5F0\uAD6C\uC758
      \uC8FC\uC778\uACF5\uC774\uC8E0."
    - "\uC704\uB300\uD55C \uC5F0\uAD6C\uB77C..."
    - "\uB4DC\uB808\uC77C: \uCC98\uC74C\uC5D0\uB294 \uADF8\uC800 \uC0B4\uC744 \uBE7C\uB294
      \uC57D\uC744 \uB9CC\uB4E4 \uC0DD\uAC01\uC774\uC5C8\uC2B5\uB2C8\uB2E4."
    - "\uB4DC\uB808\uC77C: \uD558\uC9C0\uB9CC \uACB0\uACFC\uB294 \uC81C \uC608\uC0C1\uBCF4\uB2E4
      \uD6E8\uC52C \uD765\uBBF8\uB85C\uC6E0\uC8E0."
    - "\uB4DC\uB808\uC77C: \uD558\uD558... \uB2F9\uC2E0\uB3C4 \uC9C1\uC811 \uBCF4\uC168\uC796\uC2B5\uB2C8\uAE4C."
    - "\uB4DC\uB808\uC77C: \uC778\uAC04\uC758 \uD55C\uACC4\uB97C \uB118\uC5B4\uC120
      \uC0DD\uBA85\uCCB4\uB77C\uB2C8."
    - "\uB4DC\uB808\uC77C: \uC81C\uAC00 \uC544\uB2C8\uC5C8\uB2E4\uBA74 \uADF8 \uB204\uAD6C\uB3C4
      \uB9CC\uB4E4\uC5B4\uB0B4\uC9C0 \uBABB\uD588\uC744 \uAC81\uB2C8\uB2E4."
    - " \uADF8 \uACFC\uC815\uC5D0\uC11C \uC0AC\uB78C\uC774 \uC8FD\uC5C8\uC9C0?"
    - "\uB4DC\uB808\uC77C: \uBB50 6\uBA85\uC778\uAC00?"
    - "\uB4DC\uB808\uC77C: \uBA87 \uBA85 \uC8FD\uC740 \uAC8C \uBB50\uAC00 \uC911\uC694\uD569\uB2C8\uAE4C?"
    - "\uB4DC\uB808\uC77C: \uC704\uB300\uD55C \uBC1C\uACAC\uC5D0\uB294 \uC5B8\uC81C\uB098
      \uD76C\uC0DD\uC774 \uB530\uB974\uB294 \uBC95\uC774\uC8E0."
    - "\uB108.. \uC9C4\uC9DC \uBBF8\uCE5C\uAC70\uAD70 "
    - "\uC544\uB2C8\uC9C0 "
    - "\uB0B4 \uC54C\uBE60\uAC00 \uC544\uB2C8\uC9C0.."
    - "\uC77C\uB2E8 \uC54C\uC558\uC5B4 \uB108\uC758 \uC2E4\uD5D8 \uC798 \uB418\uAE38
      \uAE30\uC6D0\uD558\uC9C0"
  - groupName: Item4
    lines:
    - "\uC7AC\uD310\uC740 \uB05D\uB0AC\uC2B5\uB2C8\uB2E4."
    - "\uD2B8\uB808\uC77C: \uC5ED\uC2DC \uB2F9\uC2E0\uC5D0\uAC8C \uB9E1\uAE30\uAE38
      \uC798\uD588\uAD70\uC694."
    - "\uADF8\uB798\uC11C... \uC81C \uBCF4\uC218\uB294?"
    - "\uD2B8\uB808\uC77C: \uBB3C\uB860 \uC900\uBE44\uD574\uB450\uC5C8\uC2B5\uB2C8\uB2E4"
    - "\uADF8\uB807\uAD70\uC694 \uC5B4\uB514\uC5D0 \uC788\uB098\uC694"
    - "\uD2B8\uB808\uC77C: \uAD6C\uAE09\uC0C1\uC790\uC5D0 \uB123\uC5B4 \uB480\uC2B5\uB2C8\uB2E4
      \uC758\uC2EC \uC548\uC0AC\uB3C4\uB85D\uC694"
    - "\uADF8\uB807\uAD70\uC694 \uC54C\uACA0\uC2B5\uB2C8\uB2E4 \uCC3E\uC544 \uBCF4\uB3C4\uB85D
      \uD558\uC8E0"
  - groupName: FirstWakeUp
    lines:
    - "\uC774\uAC8C... \uBB50\uC57C?!"
    - "\uC7A0\uAE50, \uBB34\uC2A8 \uC9D3\uC774\uC57C? \uB108... \uB0B4\uAC00 \uB204\uAD70\uC9C0
      \uC54C\uACE0 \uC774\uB7EC\uB294 \uAC70\uC57C?!"
    - "\uD2B8\uB808\uC77C:\uC720\uC6A9\uD558\uAC8C \uC4F0\uC2ED\uC2DC\uC624"
    - "\uD2B8\uB808\uC77C: \uC544 \uADF8\uB9AC\uACE0 \uB2E4\uC74C\uC5D0\uB3C4 \uBD80\uD0C1
      \uB4DC\uB9BD\uB2C8\uB2E4"
    - "\uC608 \uAC10\uC0AC\uD569\uB2C8\uB2E4"
  typingSpeed: 0.05
  delayBetweenDialogues: 2
  typingSound: {fileID: 8300000, guid: 97aefae0f5517e340a782ac788b24929, type: 3}
  soundVolume: 0.5
  allowSkip: 0
  playOnStart: 0
