  dialoguePanelBackground: {fileID: 0}
  hidePanelBackground: 1
  dialogueGroups:
  - groupName: "0_\uC2DC\uC791(0\uCD08_\uC790\uB3D9\uC9C4\uD589)"
    lines:
    - "\uB09C \uC774 \uC77C\uC744 \uAE30\uC5B5\uD558\uAE30 \uC2EB\uC5B4 \uD588\uB358\uAC70
      \uAC19\uB2E4"
    - "\uB0B4\uAC00 \uC6D0\uD558\uB294\uAC78 \uC774\uB8E8\uAE30 \uC704\uD574 "
    - "\uC544\uB2C8"
    - "\uB0B4\uAC00 \uC9D6\uBC1F\uACE0 \uC62C\uB77C\uAC00\uB354\uB77C\uB3C4 \uC5BB\uACE0
      \uC2F6\uC5C8\uB358"
    - "\uBA85\uC131\uACFC \uBD80"
    - "\uB098\uB294 \uD55C \uAC00\uC815\uC744 \uC9C0\uC625\uC5D0 \uB0B4 \uB358\uC84C\uB2E4"
    - "\uB09C \uC778\uAC04\uC774\uB77C\uB294 \uCDE8\uAE09\uC744 \uD558\uAE30 \uC5B4\uB835\uB2E4"
    - "\uB09C \uC798\uBABB\uC744 \uBC14\uB85C \uC7A1\uC544\uC57C \uD55C\uB2E4"
    - "\uD558\uC9C0\uB9CC \uAC81\uC774 \uB09C\uB2E4"
  - groupName: "1_Panel(1)_34.9\uCD08"
    lines:
    - "\uB9C8\uC9C0\uB9C9 3\uC2EC\uC758 \uACB0\uACFC \uC774\uB2E4"
    - "\uD53C\uACE0 \uB4DC\uB808\uC77C"
    - "\uB2E4\uB978 \uC784\uC0C1\uC2E4\uD5D8\uC758 \uD1B5\uBCF4\uC11C\uB85C \uBE44
      \uC724\uB9AC\uC801\uC778 \uB2E4\uC774\uC5B4\uD2B8 \uC57D\uC744 \uAC1C\uBC1C"
    - "\uC774\uB85C \uC778\uD558\uC5EC 6\uBA85\uC774 \uC0AC\uB9DD"
    - "\uD558\uC9C0\uB9CC \uADF8\uAC83\uC740 \uC798\uBABB\uB41C \uC9C0\uD45C\uC774\uACE0
      \n\uC5B4\uB514\uC11C \uC870\uC791\uB418\uC5C8\uC74C\uC744 \uD3EC\uCC29\uD558\uC600\uB2E4"
  - groupName: "2_Panel(2)_39.9\uCD08"
    lines:
    - "\uADF8\uB85C \uC778\uD558\uC5EC \uB4DC\uB808\uC77C\uC5D0\uAC8C"
    - "\uBB34\uC8C4\uB97C \uC120\uC5B8\uD55C\uB2E4 "
  - groupName: "3_Panel(3)_48.1\uCD08"
    lines:
    - "\uBB50\uB77C\uACE0?"
    - "\uB9D0 \uAC19\uC9C0 \uC54A\uC740 \uC18C\uB9AC \uD558\uC9C0\uB9C8 "
    - "\uC544\uBB34\uB9AC \uBD10\uB3C4 \uC800\uAC74 \uC800 \uB188\uC758 \uC798\uBABB\uC774
      \uB9DE\uB2E4\uACE0 \uC790\uB8CC\uAC00 \uC870\uC791\uB418\uC9C0 \uC54A\uC558\uB2E4\uACE0!"
  - groupName: "4_Panel(3)_48.1\uCD08"
    lines:
    - "\uC870\uC6A9!!!!!!"
    - "\uD310\uACB0\uC740 \uC774\uBBF8 \uB0AC\uB2E4"
